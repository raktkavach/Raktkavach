modules = ["nodejs-24"]

run = "pnpm --filter @workspace/rakt-kavach run dev -- --port 3000"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 25231
externalPort = 3000

[deployment]
run = ["sh", "-c", "pnpm --filter @workspace/rakt-kavach run build && pnpm --filter @workspace/rakt-kavach run serve -- --host 0.0.0.0 --port 3000"]
deploymentTarget = "autoscale"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
